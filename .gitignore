# Node
node_modules/

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/.icon-staging/

# Bundled runtime: CI-generated build artifact, never committed
# (regenerated by scripts/prepare-host.mjs from the pinned Harness commit)
src-tauri/resources/host/

# Logs and temporary files
*.log
*.tmp

# Secrets, keys and credentials (never commit)
*.key
*.key.pub
*.pem
*.pfx
*.p12
.env
.env.*

# Release artifacts generated by the release workflow
*.sig
latest.json
SHA256SUMS
